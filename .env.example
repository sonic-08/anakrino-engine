# Google Gemini API Key (Private Server Secret - Keep this private!)
# In Vercel, add this as a "Secret" under Environment Variables.
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Authentication & Database (Client-safe public keys)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
